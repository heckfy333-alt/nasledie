generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Person {
  id           Int            @id @default(autoincrement())

  name         String
  role         String
  photo        String

  biography    String?
  bio          String?

  birthPlace   String?
  birthDate    String?

  deathPlace   String?
  deathDate    String?

  birthLat     Float?
  birthLng     Float?

  createdAt    DateTime       @default(now())

  events         Event[]
  candles        Candle[]
  memories       Memory[]
  comments       Comment[]
  photos         FamilyPhoto[]
  voiceMemories  VoiceMemory[]
}

model Event {
  id          Int       @id @default(autoincrement())

  year        String
  title       String
  description String

  createdAt   DateTime  @default(now())

  personId    Int
  person      Person    @relation(fields: [personId], references: [id])
}

model Candle {
  id          Int       @id @default(autoincrement())

  author      String

  createdAt   DateTime  @default(now())

  personId    Int
  person      Person    @relation(fields: [personId], references: [id])
}

model Memory {
  id          Int       @id @default(autoincrement())

  title       String
  content     String

  createdAt   DateTime  @default(now())

  personId    Int
  person      Person    @relation(fields: [personId], references: [id])
}

model Comment {
  id          Int       @id @default(autoincrement())

  author      String
  text        String

  createdAt   DateTime  @default(now())

  personId    Int
  person      Person    @relation(fields: [personId], references: [id])
}

model FamilyPhoto {
  id          Int       @id @default(autoincrement())

  imageUrl    String

  createdAt   DateTime  @default(now())

  personId    Int
  person      Person    @relation(fields: [personId], references: [id])
}

model VoiceMemory {
  id          Int       @id @default(autoincrement())

  title       String
  audioUrl    String

  createdAt   DateTime  @default(now())

  personId    Int
  person      Person    @relation(fields: [personId], references: [id])
}

model Invitation {
  id          Int       @id @default(autoincrement())

  email       String

  createdAt   DateTime  @default(now())
}

model User {
  id          Int       @id @default(autoincrement())

  name        String
  email       String    @unique
  password    String

  createdAt   DateTime  @default(now())
}