generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemoryKind {
  STORY
  PHOTO
  DOCUMENT
  VOICE
  AI_BIOGRAPHY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people      Person[]
  memories    Memory[]
  comments    Comment[]
  candles     Candle[]
  invitations Invitation[] @relation("InvitationSender")
}

model Person {
  id          Int      @id @default(autoincrement())
  name        String
  firstName   String?
  lastName    String?
  role        String?
  photo       String?
  biography   String?  @db.Text
  bio         String?  @db.Text
  birthDate   DateTime?
  deathDate   DateTime?
  birthPlace  String?
  deathPlace  String?
  city        String?
  birthLat    Float?
  birthLng    Float?
  deathLat    Float?
  deathLng    Float?
  qrSlug      String   @unique @default(uuid())
  isPublic    Boolean  @default(false)
  aiDraft     String?  @db.Text
  fatherId    Int?
  motherId    Int?
  ownerId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  father        Person?        @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  fatherChildren Person[]      @relation("FatherChildren")
  mother        Person?        @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  motherChildren Person[]      @relation("MotherChildren")
  events        Event[]
  memories      Memory[]
  comments      Comment[]
  candles       Candle[]
  voiceMemories VoiceMemory[]
  photos        FamilyPhoto[]
  documents     Document[]
  invitations   Invitation[]

  @@index([ownerId])
  @@index([fatherId])
  @@index([motherId])
  @@index([name])
}

model Event {
  id          Int      @id @default(autoincrement())
  year        String?
  title       String
  description String   @db.Text
  happenedAt  DateTime?
  place       String?
  lat         Float?
  lng         Float?
  personId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Memory {
  id        Int        @id @default(autoincrement())
  title     String
  content   String     @db.Text
  kind      MemoryKind @default(STORY)
  mediaUrl  String?
  personId  Int
  authorId  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Comment {
  id        Int      @id @default(autoincrement())
  author    String
  text      String   @db.Text
  personId  Int
  userId    Int?
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Candle {
  id        Int      @id @default(autoincrement())
  author    String
  message   String?  @db.Text
  personId  Int
  userId    Int?
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VoiceMemory {
  id        Int      @id @default(autoincrement())
  title     String
  audioUrl  String
  duration  Int?
  personId  Int
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model FamilyPhoto {
  id        Int      @id @default(autoincrement())
  title     String?
  imageUrl  String
  personId  Int
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Document {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String
  fileType  String?
  personId  Int
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        Int              @id @default(autoincrement())
  email     String
  token     String           @unique @default(uuid())
  status    InvitationStatus @default(PENDING)
  personId  Int?
  senderId  Int?
  createdAt DateTime         @default(now())
  expiresAt DateTime?

  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  sender User?   @relation("InvitationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([email])
}
